<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#0F172A">

    <!-- TOP INDUSTRIAL APP BAR -->
    <LinearLayout
        android:id="@+id/top_bar"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:background="#160A8A"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="12dp"
        app:layout_constraintTop_toTopOf="parent">

        <!-- LOGO TEXT -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="WelVision"
            android:textColor="#FFFFFF"
            android:textSize="17sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:background="#2E1065"
            android:paddingHorizontal="6dp"
            android:paddingVertical="2dp"
            android:text="Scanner"
            android:textColor="#C084FC"
            android:textSize="10sp"
            android:textStyle="bold" />

        <View
            android:layout_width="0dp"
            android:layout_height="1dp"
            android:layout_weight="1" />

        <!-- ZEBRA HARDWARE SCANNER STATUS -->
        <TextView
            android:id="@+id/scanner_status_badge"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginEnd="8dp"
            android:background="#064E3B"
            android:paddingHorizontal="8dp"
            android:paddingVertical="3dp"
            android:text="Laser Ready"
            android:textColor="#34D399"
            android:textSize="10sp"
            android:textStyle="bold" />

        <!-- SERVER SETTINGS BUTTON -->
        <ImageButton
            android:id="@+id/btn_settings"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="Server Settings"
            android:src="@android:drawable/ic_menu_preferences"
            app:tint="#FFFFFF" />

        <!-- REFRESH BUTTON -->
        <ImageButton
            android:id="@+id/btn_refresh"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="Reload"
            android:src="@android:drawable/ic_menu_rotate"
            app:tint="#FFFFFF" />
    </LinearLayout>

    <!-- LOADING PROGRESS BAR -->
    <ProgressBar
        android:id="@+id/progress_bar"
        style="?android:attr/progressBarStyleHorizontal"
        android:layout_width="match_parent"
        android:layout_height="4dp"
        android:indeterminate="false"
        android:max="100"
        android:progressDrawable="@android:drawable/progress_horizontal"
        android:visibility="gone"
        app:layout_constraintTop_toBottomOf="@id/top_bar" />

    <!-- MAIN INTERACTIVE WEBVIEW -->
    <WebView
        android:id="@+id/webview"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/top_bar" />

    <!-- OFFLINE / CONNECTION ERROR CONTAINER -->
    <LinearLayout
        android:id="@+id/offline_container"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:background="#0F172A"
        android:gravity="center"
        android:orientation="vertical"
        android:padding="24dp"
        android:visibility="gone"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/top_bar">

        <ImageView
            android:layout_width="64dp"
            android:layout_height="64dp"
            android:layout_marginBottom="16dp"
            android:src="@android:drawable/ic_dialog_alert"
            app:tint="#F59E0B" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Cannot Reach WelVision Server"
            android:textColor="#FFFFFF"
            android:textSize="18sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/text_error_details"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:layout_marginBottom="24dp"
            android:gravity="center"
            android:text="Please check mill Wi-Fi or configure the server IP address."
            android:textColor="#94A3B8"
            android:textSize="13sp" />

        <Button
            android:id="@+id/btn_retry"
            android:layout_width="200dp"
            android:layout_height="48dp"
            android:layout_marginBottom="12dp"
            android:backgroundTint="#160A8A"
            android:text="Retry Connection"
            android:textColor="#FFFFFF" />

        <Button
            android:id="@+id/btn_change_server"
            android:layout_width="200dp"
            android:layout_height="48dp"
            android:backgroundTint="#334155"
            android:text="Change Server IP"
            android:textColor="#E2E8F0" />
    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
